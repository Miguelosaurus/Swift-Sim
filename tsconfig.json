{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "allowJs": true,
    "checkJs": false,
    "sourceMap": true,
    "declaration": false,
    "noEmitOnError": true,
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "resolveJsonModule": true,
    "skipLibCheck": false
  },
  "include": [
    "mac-helper/**/*.js",
    "mac-helper/**/*.ts",
    "scripts/**/*.js",
    "scripts/**/*.ts",
    "benchmarks/**/*.js",
    "benchmarks/**/*.ts",
    "test/**/*.js",
    "test/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", ".build", "**/*.tsx", "Companion"]
}
