{
  "name": "swift-sim",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Install signed iPhone builds and preview Mac Simulators from mobile-controlled coding agents.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miguelosaurus/Swift-Sim.git"
  },
  "homepage": "https://github.com/Miguelosaurus/Swift-Sim#readme",
  "bugs": {
    "url": "https://github.com/Miguelosaurus/Swift-Sim/issues"
  },
  "bin": {
    "swift-sim": "./mac-helper/bin/swift-sim.js",
    "swift-sim-helper": "./mac-helper/bin/swift-sim-helper.js"
  },
  "scripts": {
    "start": "node mac-helper/bin/swift-sim.js serve",
    "check": "node --check mac-helper/bin/swift-sim.js && node --check mac-helper/bin/swift-sim-helper.js && node --check mac-helper/bin/swift-sim-device-delivery.js && npm run check:docs && npm test",
    "check:docs": "node scripts/verify-docs.js",
    "test": "node --test test/*.test.js benchmarks/test/*.test.js",
    "test:benchmarks": "node --test benchmarks/test/*.test.js",
    "benchmark:generate": "node benchmarks/src/generateCoreCorpus.js && node benchmarks/src/generateLiquidGlassCorpus.js && node benchmarks/src/generateNativeSurfaceCorpus.js && node benchmarks/src/generateMechanismCorpus.js",
    "benchmark:generate:liquid-glass": "node benchmarks/src/generateLiquidGlassCorpus.js",
    "benchmark:generate:native-surfaces": "node benchmarks/src/generateNativeSurfaceCorpus.js",
    "benchmark:generate:mechanisms": "node benchmarks/src/generateMechanismCorpus.js",
    "benchmark:validate": "node benchmarks/src/cli.js validate",
    "benchmark:validate:liquid-glass": "node benchmarks/src/cli.js validate --corpus benchmarks/corpora/liquid-glass/corpus.json",
    "benchmark:validate:native-surfaces": "node benchmarks/src/cli.js validate --corpus benchmarks/corpora/native-surfaces/corpus.json",
    "benchmark:validate:mechanisms": "node benchmarks/src/cli.js validate --corpus benchmarks/corpora/mechanisms/corpus.json",
    "benchmark:static": "node benchmarks/src/cli.js static",
    "benchmark:static:liquid-glass": "node benchmarks/src/cli.js static --corpus benchmarks/corpora/liquid-glass/corpus.json",
    "benchmark:static:native-surfaces": "node benchmarks/src/cli.js static --corpus benchmarks/corpora/native-surfaces/corpus.json",
    "benchmark:static:mechanisms": "node benchmarks/src/cli.js static --corpus benchmarks/corpora/mechanisms/corpus.json",
    "benchmark:device": "node benchmarks/src/cli.js device",
    "benchmark:report": "node benchmarks/src/cli.js report"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "serve-sim": "0.1.44"
  }
}
