{
  "name": "swift-sim",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Install signed iPhone builds and preview Mac Simulators from mobile-controlled coding agents.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miguelosaurus/Swift-Sim.git"
  },
  "homepage": "https://github.com/Miguelosaurus/Swift-Sim#readme",
  "bugs": {
    "url": "https://github.com/Miguelosaurus/Swift-Sim/issues"
  },
  "bin": {
    "swift-sim": "./mac-helper/bin/swift-sim-entry.js",
    "swift-sim-helper": "./mac-helper/bin/swift-sim-helper-entry.js"
  },
  "scripts": {
    "start": "node mac-helper/bin/swift-sim-entry.js serve",
    "check": "node --check mac-helper/bin/swift-sim-entry.js && node --check mac-helper/bin/swift-sim-helper-entry.js && node --check mac-helper/src/buildValidation.js && node --check mac-helper/bin/swift-sim.js && node --check mac-helper/bin/swift-sim-helper.js && node --check mac-helper/bin/swift-sim-device-delivery.js && npm run check:docs && npm test",
    "check:docs": "node scripts/verify-docs.js",
    "test": "node --test test/*.test.js benchmarks/test/*.test.js",
    "test:benchmarks": "node --test benchmarks/test/*.test.js",
    "benchmark:generate": "node benchmarks/src/generateCoreCorpus.js",
    "benchmark:validate": "node benchmarks/src/cli.js validate",
    "benchmark:static": "node benchmarks/src/cli.js static",
    "benchmark:device": "node benchmarks/src/cli.js device",
    "benchmark:report": "node benchmarks/src/cli.js report"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "serve-sim": "0.1.44"
  }
}
